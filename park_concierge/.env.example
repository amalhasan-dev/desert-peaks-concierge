# Copy to park_concierge/.env (never commit .env). Fill ONE block.

# Option A - local development with an AI Studio key.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=paste-your-key-here

# Option B - Vertex AI in your GCP project (deploys use this; no API key needed).
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# ENABLE_CONTEXT_CACHE=true

# Optional model routing overrides (defaults: lite for fast tasks, flash for bookings).
# ADK_FAST_MODEL=gemini-flash-lite-latest
# ADK_SMART_MODEL=gemini-flash-latest
